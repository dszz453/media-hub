# ===========================================================================
#  MediaHub 环境变量
#  用法： cp .env.example .env  然后按需填写
# ===========================================================================

# ---------- 端口 ----------
HOST_PORT=8000

# ---------------------------------------------------------------------------
# 小红书
# ---------------------------------------------------------------------------
# 必填（否则小红书不可用）。
# 获取方式：浏览器登录 xiaohongshu.com → F12 → Network → 任意请求 → 复制完整 Cookie。
# 最少需要 web_session；建议同时带上 a1 和 webId（三者齐全最稳）。
# 例：XHS_COOKIE=a1=xxx; web_session=0400698xxxx; webId=xxxx
XHS_COOKIE=
XHS_ENABLED=true

# 可选。留空则使用 xhs 库内置的纯 Python 签名（无需 playwright）。
# 如果本地签名被风控拦截，可以起浏览器级签名服务：
#   docker compose --profile sign up -d
# 然后填 http://xhs-sign:5005
XHS_SIGN_SERVER=

# ---------------------------------------------------------------------------
# 抖音
# ---------------------------------------------------------------------------
# 必填。抖音的搜索与详情接口都要求登录态，没有 cookie 会直接返回
#   2483「请先登录，再继续搜索吧」 / 403「Uifid Not Found」
# 获取方式：浏览器登录 douyin.com → F12 → Network → 复制完整 Cookie。
DOUYIN_COOKIE=
DOUYIN_ENABLED=true

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
YOUTUBE_ENABLED=true
YOUTUBE_REGION=HK

# 国内网络访问 YouTube 通常需要代理，形如 http://host:7890
PROXY=

# 可选：Netscape 格式的 cookies.txt（用于观看需要登录的会员视频）
YTDLP_COOKIES_FILE=

# ---------------------------------------------------------------------------
# 音频输出
# ---------------------------------------------------------------------------
# mp3 兼容性最好且支持封面内嵌；m4a 体积更小
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192k
EMBED_COVER=true
EMBED_METADATA=true
# 是否保留下载下来的原始视频（默认转完就删，省空间）
KEEP_VIDEO=false

# ---------------------------------------------------------------------------
# 并发与缓存
# ---------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
DOWNLOAD_TIMEOUT=600
SEARCH_TIMEOUT=20
# 搜索结果缓存秒数，0 = 关闭
SEARCH_CACHE_TTL=600
