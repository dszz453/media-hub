# ===========================================================================
#  MediaHub 环境变量
#  用法： cp .env.example .env  然后按需填写
# ===========================================================================

# ---------- 端口 ----------
HOST_PORT=8000

# ---------------------------------------------------------------------------
# 扫码登录（推荐）
# ---------------------------------------------------------------------------
# 小红书和抖音的登录接口都只认真实浏览器：
#   * 小红书 web 的 x-s 签名算法持续升级，纯 Python 实现（xhs 库）实测在登录
#     接口上稳定返回 406；
#   * 抖音 passport 接口有风控（rc-verifycenter / rmc-nocaptcha），
#     headless 浏览器会被判定为机器人、直接不下发二维码，必须跑有头模式。
# 所以由独立的 login-agent 容器（Chromium + Xvfb）生成二维码，网页「账号」页扫码即可。
# 扫码得到的凭据会存到 data/cookies.json，优先级高于下面的静态 Cookie。
LOGIN_ENABLED=true
LOGIN_AGENT_URL=http://login-agent:8100
# 生成二维码的最长等待秒数。
# 小红书 10 秒左右；抖音慢得多 —— 它首页是无限视频流，要先点开登录面板
# 再等风控 SDK 把二维码渲染出来，在弱机器（比如 J1900 这类小主机）上
# 实测要 60~150 秒。所以这里给到 360，别调小。
LOGIN_TIMEOUT=360

# ---------------------------------------------------------------------------
# 小红书
# ---------------------------------------------------------------------------
# 可以留空 —— 用网页「账号」页扫码即可。
# 若坚持手动配置：浏览器登录 xiaohongshu.com → F12 → Network → 复制完整 Cookie。
XHS_COOKIE=
XHS_ENABLED=true

# 可选。留空则使用 xhs 库内置的纯 Python 签名。
# 注意：该实现在 2026-10 实测已无法通过登录类接口的校验，仅作兜底。
XHS_SIGN_SERVER=

# ---------------------------------------------------------------------------
# 抖音
# ---------------------------------------------------------------------------
# 可以留空 —— 用网页「账号」页扫码即可。
# 手动配置的话：浏览器登录 douyin.com → F12 → Network → 复制完整 Cookie。
# 没有登录态时搜索会返回 2483「请先登录」，详情返回 403「Uifid Not Found」。
DOUYIN_COOKIE=
DOUYIN_ENABLED=true

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
YOUTUBE_ENABLED=true
YOUTUBE_REGION=HK

# 国内网络访问 YouTube 通常需要代理，形如 http://host:7890
PROXY=

# 可选：Netscape 格式的 cookies.txt（用于观看需要登录的会员视频）
YTDLP_COOKIES_FILE=

# ---------------------------------------------------------------------------
# 音频输出
# ---------------------------------------------------------------------------
# mp3 兼容性最好且支持封面内嵌；m4a 体积更小
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192k
EMBED_COVER=true
EMBED_METADATA=true
# 是否保留下载下来的原始视频（默认转完就删，省空间）
KEEP_VIDEO=false

# ---------------------------------------------------------------------------
# 并发与缓存
# ---------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
DOWNLOAD_TIMEOUT=600
SEARCH_TIMEOUT=20
# 搜索结果缓存秒数，0 = 关闭
SEARCH_CACHE_TTL=600
